# .env.example
# Copy this to .env and fill in your values

# Supabase (required for VERTIKAL app)
EXPO_PUBLIC_SUPABASE_URL=https://dyhmyvzgqonngzjueyoq.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# API Configuration (local dev; production uses eas.json / EAS env)
EXPO_PUBLIC_API_URL=http://localhost:4000

# Sentry (Error Tracking) — set in EAS secrets for production builds
EXPO_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Feature Flags (optional)
EXPO_PUBLIC_ENABLE_ANALYTICS=true
EXPO_PUBLIC_ENABLE_SUBSCRIPTIONS=true

# Development (optional)
EXPO_PUBLIC_DEBUG_API=false

# Supabase service role (server/scripts/Netlify only — never EXPO_PUBLIC or client code)
SUPABASE_URL=https://dyhmyvzgqonngzjueyoq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
# Optional alias used by scripts/ingest_seed_videos.js
SUPABASE_SERVICE_KEY=your-service-role-or-secret-key
