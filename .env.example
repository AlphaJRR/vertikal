# .env.example
# Copy this to .env and fill in your values

# Supabase — AVA mobile app (canonical project ref: dyhmyvzgqonngzjueyoq)
# Legacy ref vuwawtzhhcarckybdgbd appears in old web/Prisma docs and Cursor Supabase MCP;
# do NOT point mobile or EAS secrets at vuwawtzhhcarckybdgbd.
# Production keys live in Expo → EAS → Environment variables (not in eas.json or app.json).
EXPO_PUBLIC_SUPABASE_URL=https://dyhmyvzgqonngzjueyoq.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# API Configuration (local dev; production uses eas.json / EAS env)
EXPO_PUBLIC_API_URL=http://localhost:4000

# Sentry (Error Tracking) — set in EAS secrets for production builds
EXPO_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Feature Flags (optional)
EXPO_PUBLIC_ENABLE_ANALYTICS=true
EXPO_PUBLIC_ENABLE_SUBSCRIPTIONS=true

# Klaviyo waitlist (Vite web landing — Alpha-Visual-Artist repo, Cloudflare Pages)
# Real values pending; copy to artifacts/alpha-visual-artists/.env.local for local dev
VITE_KLAVIYO_PUBLIC_KEY=your_klaviyo_public_site_id_here
VITE_KLAVIYO_LIST_ID=your_klaviyo_list_id_here

# RevenueCat — ALPHA Creators Pro IAP (iOS only; set in EAS production env)
# Dashboard → Project → API keys → Apple App Store public SDK key (starts with appl_)
# Sandbox / test project keys may start with test_ — use only for local dev, never commit real keys
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_your_revenuecat_ios_public_key_here

# Supabase Edge Function secret (server only — NOT EXPO_PUBLIC)
# Set via: supabase secrets set REVENUECAT_WEBHOOK_SECRET=<random-string>
# Use same value as RevenueCat webhook Authorization: Bearer <secret>
REVENUECAT_WEBHOOK_SECRET=your_webhook_bearer_secret_here

# Wallpapers CDN (remote images — upload 114 files before shipping tab)
# Default: site static at /wallpapers/<filename> on alphavisualartists.com
# Supabase alt: https://dyhmyvzgqonngzjueyoq.supabase.co/storage/v1/object/public/wallpapers
EXPO_PUBLIC_WALLPAPER_CDN_BASE=https://alphavisualartists.com/wallpapers

# Development (optional)
EXPO_PUBLIC_DEBUG_API=false

# App Review demo account (Supabase Authentication — password set in dashboard only)
# Email: appreview@alphavisualartists.com
# Password: configure in Supabase Dashboard → Authentication → Users (do NOT commit)
# profiles.subscription_tier must be 'pro' for full AVA Pro unlock during review

# Supabase service role (server/scripts/Netlify only — never EXPO_PUBLIC or client code)
SUPABASE_URL=https://dyhmyvzgqonngzjueyoq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
# Optional alias used by scripts/ingest_seed_videos.js
SUPABASE_SERVICE_KEY=your-service-role-or-secret-key
