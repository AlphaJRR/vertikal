{
  "expo": {
    "name": "Alpha Visual Artists",
    "slug": "alpha-visual-artists",
    "version": "1.30.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ava",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.alphavisualartists.app",
      "buildNumber": "27",
      "associatedDomains": [
        "applinks:alphavisualartists.com"
      ],
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Access photos to upload event images.",
        "NSPhotoLibraryAddUsageDescription": "Save your event photos to your library.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSExceptionDomains": {
            "alphavisualartists.com": {
              "NSIncludesSubdomains": true,
              "NSExceptionAllowsInsecureHTTPLoads": false,
              "NSExceptionMinimumTLSVersion": "TLSv1.2",
              "NSExceptionRequiresForwardSecrecy": true
            }
          }
        }
      }
    },
    "android": {
      "package": "com.alphavisualartists.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0a"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "alphavisualartists.com",
              "pathPrefix": "/r"
            },
            {
              "scheme": "https",
              "host": "alphavisualartists.com",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://alphavisualartists.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-video",
      "expo-updates",
      [
        "expo-media-library",
        {
          "photosPermission": "Access photos to upload event images.",
          "savePhotosPermission": "Save your event photos to your library."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Access photos to upload event images."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0a0a0a"
        }
      ],
      "react-native-purchases"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "alpha_jrr",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "39911e65-82a6-47ca-af2b-3769a15817df"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/39911e65-82a6-47ca-af2b-3769a15817df"
    }
  }
}
