{
  "expo": {
    "name": "Alpha Visual Artists",
    "slug": "alpha-visual-artists",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ava",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.alphavisualartists.app",
      "infoPlist": {
        "NSPhotoLibraryAddUsageDescription": "AVA saves wallpapers you download to your Photo Library.",
        "NSPhotoLibraryUsageDescription": "AVA needs access to save wallpapers to your Photo Library.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSExceptionDomains": {
            "alphavisualartists.com": {
              "NSIncludesSubdomains": true,
              "NSExceptionAllowsInsecureHTTPLoads": false,
              "NSExceptionMinimumTLSVersion": "TLSv1.2",
              "NSExceptionRequiresForwardSecrecy": true
            }
          }
        }
      },
      "buildNumber": "11"
    },
    "android": {
      "package": "com.alphavisualartists.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0a"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "alphavisualartists.com",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://alphavisualartists.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-video",
      "expo-updates",
      [
        "expo-media-library",
        {
          "photosPermission": "AVA needs access to save wallpapers to your Photo Library.",
          "savePhotosPermission": "AVA saves wallpapers you download to your Photo Library."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "alpha_jrr",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "39911e65-82a6-47ca-af2b-3769a15817df"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/39911e65-82a6-47ca-af2b-3769a15817df"
    }
  }
}
