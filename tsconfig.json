{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "resolveJsonModule": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "ios",
    "android",
    "dist",
    "artifacts",
    "capacitor.config.ts",
    "components/feed",
    "components/profile",
    "components/auth",
    "components/layout",
    "components/ui",
    "components/video",
    "components/DevRoleSwitcher.tsx",
    "components/Featured.tsx"
  ],
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
