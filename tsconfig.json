{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "resolveJsonModule": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "ios",
    "android",
    "dist",
    "artifacts",
    "capacitor.config.ts",
    "ios-capacitor-backup",
    "android-capacitor-backup",
    "services",
    "scripts",
    "tests",
    "prisma",
    "supabase/functions",
    "backend",
    "providers",
    "netlify",
    "utils/auth.ts",
    "utils/storage.ts",
    "utils/sentry.ts",
    "utils/joshuaArgueVideoSeed.ts",
    "utils/avaVideoSeed.ts",
    "utils/dataTransform.ts",
    "types/index.ts",
    "types/api.ts",
    "data.ts",
    "config",
    "playwright.config.ts",
    "vite.config.ts",
    "_broken-web-toolkit-snapshot",
    "src"
  ],
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
